# Supabase credentials untuk local development.
# Copy ke .env.local dan isi dengan project sendiri.

NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://lhbhyrymyzuavllinike.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_50O14uvjOo3JoA4Gajpwfw_tM0Dm0f7

# --- Platform BE (server-only, JANGAN pakai prefix NEXT_PUBLIC_) ---
# Diisi di Vercel dashboard (Production), bukan di-commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform BE AI: Gemini (server-only, JANGAN pakai prefix NEXT_PUBLIC_) ---
# Default model WAJIB di ENV (kode hanya fallback). Kandidat failover opsional,
# comma-separated, dicoba berurutan kalau model sebelumnya limit/overload.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_CANDIDATES=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite

# Base URL publik untuk link /report/:id (Vercel mengisi VERCEL_URL otomatis;
# var ini opsional kalau domain custom).
SONIC_POINT_REPORT_BASE_URL=https://sonicpoint.vercel.app
